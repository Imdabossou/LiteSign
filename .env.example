# Copy this file to .env and edit before running docker compose up

# Password for the single admin account (the only login this app has).
# Required: the app refuses to start without one. Use something long and
# random, e.g. the output of: openssl rand -base64 24
ADMIN_PASSWORD=

# Public URL where this app is reachable — used to build the signing links
# shown/emailed to signers, and to correctly mark the session cookie as
# HTTPS-only once you're behind real TLS. Set this to your real domain,
# e.g. https://sign.yourdomain.com
BASE_URL=http://localhost:8080

# --- Outgoing email (SMTP) ---
# Required for LiteSign to email signing links and completed documents
# automatically. Leave SMTP_HOST blank to disable email sending — you'll
# still get links shown in the dashboard to send yourself.
# Works with any standard SMTP provider: Gmail (with an app password),
# SendGrid, Mailgun, Amazon SES, Postmark, your own mail server, etc.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true only if you're using port 465 (implicit TLS).
# Port 587/25 use STARTTLS automatically and should leave this unset/false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address that signing emails appear to come from. Defaults to SMTP_USER.
SMTP_FROM=

# Number of reverse-proxy hops in front of this app (nginx/Caddy/Cloudflare
# Tunnel = 1). Needed for correct signer IP addresses in the audit log and
# for secure cookies to work. Leave at 1 for a typical single-proxy setup.
TRUST_PROXY=1

# Name shown in emails ("Sent via ...").
APP_NAME=LiteSign
